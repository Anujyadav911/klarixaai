# NOTE: These localhost URLs are for running the app locally without Docker.
# When using `docker compose up`, Docker automatically overrides these to use the internal container names (e.g., 'postgres', 'redis').
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notifications
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-change-in-production
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=3600
PROVIDER_FAILURE_RATE=0.1
